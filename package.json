{
  "name": "os-sim",
  "private": true,
  "version": "1.0.0",
  "description": "An operating system's core subsystems running in the browser: MLFQ scheduling, demand paging, a journaling filesystem, pipes and semaphores.",
  "author": "Michał Błaszczykowski",
  "license": "MIT",
  "keywords": [
    "operating-system",
    "simulator",
    "scheduler",
    "mlfq",
    "paging",
    "filesystem",
    "visualization",
    "education"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test:e2e": "npm run build && playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "diagrams": "node scripts/diagrams.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "fast-check": "^4.9.0",
    "gh-pages": "^6.1.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vitest": "^2.0.5"
  }
}
